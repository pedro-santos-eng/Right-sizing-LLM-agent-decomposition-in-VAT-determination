{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.local/schemas/agent_case_view.schema.json",
  "title": "Agent-visible case projection (label-isolated)",
  "description": "The exact and only shape that may cross into agent context (grounding HARNESS_GROUNDING_1_SURFACE §1.1). Strict: additionalProperties false at every level and all fields required, so the CLS label 'true_category' cannot appear.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "supplier_country",
    "customer_country",
    "customer_vat_registered",
    "transaction_type",
    "line_items"
  ],
  "properties": {
    "case_id": { "type": "string" },
    "supplier_country": { "enum": ["DE", "FR", "IE", "ES"] },
    "customer_country": { "enum": ["DE", "FR", "IE", "ES"] },
    "customer_vat_registered": { "type": "boolean" },
    "transaction_type": { "enum": ["B2B", "B2C"] },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["line_id", "description", "amount"],
        "properties": {
          "line_id": { "type": "string" },
          "description": { "type": "string" },
          "amount": { "type": "number" }
        }
      }
    }
  }
}
